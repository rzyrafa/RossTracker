<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: adb-triggered bulk import for stress tests. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugImportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="pl.rosstracker.DEBUG_IMPORT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
